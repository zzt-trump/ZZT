        )


def utc_now_text() -> str:
    return dt.datetime.now(dt.timezone.utc).astimezone().strftime("%Y-%m-%d %H:%M:%S %z")


def table_service(table_id: str) -> str:
    tid = table_id.lower()
    if tid in MES_TABLES:
        return "MES"
    return "ERP"


def table_name(table_id: str) -> str:
    return TABLE_NAMES.get(table_id.lower(), table_id.lower())


def table_id_from_filename(path: Path) -> str:
    match = re.match(r"^(T\d+)", path.stem, flags=re.IGNORECASE)
    if match:
        return match.group(1).lower()
    return re.sub(r"\W+", "_", path.stem).strip("_").lower()


def clean_row(row: Dict[str, Any]) -> Dict[str, str]:
    cleaned: Dict[str, str] = {}
    for key, value in row.items():
        if key is None:
            continue
        k = str(key).strip()
        if value is None:
            cleaned[k] = ""
        else:
            cleaned[k] = str(value).strip()
    return cleaned


def load_from_csv(csv_dir: str) -> Dict[str, TableData]:
    base = Path(csv_dir).expanduser()
    if not base.exists() or not base.is_dir():
        raise FileNotFoundError(f"CSV directory does not exist: {base}")

    tables: Dict[str, TableData] = {}
    for path in sorted(base.glob("*.csv")):
        table_id = table_id_from_filename(path)
        with path.open("r", encoding="utf-8-sig", newline="") as f:
            reader = csv.DictReader(f)
            columns = [c.strip() for c in (reader.fieldnames or [])]
            rows = [clean_row(row) for row in reader]
        if not columns:
            continue
        tables[table_id] = TableData(
            table_id=table_id,
            name=table_name(table_id),
            service=table_service(table_id),
            file=path.name,
            columns=columns,
            rows=rows,
        )
    if not tables:
        raise ValueError(f"No CSV tables found in {base}")
    return tables


def http_json(
    url: str,
    method: str = "GET",
    body: Optional[Dict[str, Any]] = None,
    headers: Optional[Dict[str, str]] = None,
    timeout: float = 60,
) -> Dict[str, Any]:
    data = None
    request_headers = {"Content-Type": "application/json"}
    if headers:
        request_headers.update(headers)
    if body is not None:
        data = json.dumps(body, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=request_headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8")
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {exc.code} for {url}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"Cannot reach {url}: {exc}") from exc


def fetch_service_tables(base_url: str, token: str, service_name: str) -> Dict[str, TableData]:
    base = base_url.rstrip("/")
    headers = {"Authorization": f"Bearer {token}"}
    listing = http_json(f"{base}/api/tables", headers=headers, timeout=30)
    tables: Dict[str, TableData] = {}
    for meta in listing.get("tables", []):
        table_id = str(meta.get("id", "")).lower()
        if not table_id:
            continue
        total = int(meta.get("rows") or 0)
        payload = http_json(
            f"{base}/api/tables/{table_id}?limit=5000&offset=0",
            headers=headers,
            timeout=60,
        )
        rows = [clean_row(row) for row in payload.get("rows", [])]
        columns = [str(c) for c in payload.get("columns", meta.get("columns", []))]
        if total and len(rows) < total:
            raise RuntimeError(
                f"{service_name} {table_id} returned {len(rows)} rows, expected {total}; "
                "increase API limit support before benchmarking."
            )
        tables[table_id] = TableData(
            table_id=table_id,
            name=TABLE_NAMES.get(table_id, str(meta.get("name", table_id))),
            service=service_name,
            file=str(meta.get("file", "")),
            columns=columns,
            rows=rows,
        )
    return tables


def load_from_api(args: argparse.Namespace) -> Dict[str, TableData]:
    tables = {}
    tables.update(fetch_service_tables(args.erp_api, args.erp_token, "ERP"))
    tables.update(fetch_service_tables(args.mes_api, args.mes_token, "MES"))
    if not tables:
        raise ValueError("No tables fetched from mock APIs")
    return tables


def num(value: Any, default: float = 0.0) -> float:
    if value is None:
        return default
    text = str(value).strip().replace(",", "")
    if text == "":
        return default
    try:
        return float(text)
    except ValueError:
        return default


def date_value(value: Any) -> Optional[dt.date]:
    text = str(value or "").strip()
    if not text:
        return None
    for fmt in ("%Y-%m-%d", "%Y/%m/%d"):
        try:
            return dt.datetime.strptime(text[:10], fmt).date()
        except ValueError:
            pass
    return None


def fmt_number(value: float, digits: int = 2) -> str:
    if math.isfinite(value) and abs(value - round(value)) < 1e-9:
        return f"{int(round(value))}"
    return f"{value:.{digits}f}".rstrip("0").rstrip(".")


def fmt_pct(value: float, digits: int = 1) -> str:
    return f"{value * 100:.{digits}f}%"


def markdown_table(rows: Sequence[Dict[str, Any]], columns: Optional[Sequence[str]] = None, max_rows: int = 20) -> str:
    selected = list(rows[:max_rows])
    if not selected:
        return "_无数据_"
    cols = list(columns or selected[0].keys())

    def cell(value: Any) -> str:
        text = str(value if value is not None else "")
        text = text.replace("\n", " ").replace("|", "/")
        return text

    lines = ["| " + " | ".join(cols) + " |", "| " + " | ".join(["---"] * len(cols)) + " |"]
    for row in selected:
        lines.append("| " + " | ".join(cell(row.get(col, "")) for col in cols) + " |")
    if len(rows) > max_rows:
        lines.append(f"| ... | {' | '.join([''] * (len(cols) - 1))} |")
    return "\n".join(lines)


def compact_schema(tables: Dict[str, TableData], ids: Sequence[str]) -> str:
    lines = []
    for table_id in ids:
        table = tables.get(table_id)
        if not table:
            continue
        cols = "、".join(table.columns)
        lines.append(f"- {table.service}.{table.table_id} {table.name}: {cols}")
    return "\n".join(lines)


def first_row(rows: Iterable[Dict[str, str]], predicate) -> Optional[Dict[str, str]]:
    for row in rows:
        try:
            if predicate(row):
                return row
        except Exception:
            continue
    return None


def group_by(rows: Iterable[Dict[str, str]], key: str) -> Dict[str, List[Dict[str, str]]]:
    grouped: Dict[str, List[Dict[str, str]]] = {}
    for row in rows:
        grouped.setdefault(row.get(key, ""), []).append(row)
    return grouped


def add_case(cases: List[Case], case: Optional[Case]) -> None:
    if case is not None:
        cases.append(case)


