@dataclasses.dataclass
class TableData:
    table_id: str
    name: str
    service: str
    file: str
    columns: List[str]
    rows: List[Dict[str, str]]


@dataclasses.dataclass
class Case:
    case_id: str
    category: str
    difficulty: str
    source_tables: List[str]
    question: str
    context: str
    expected: str
    scoring: Dict[str, Any]
    tags: List[str] = dataclasses.field(default_factory=list)

    def prompt(self) -> str:
        return (
            f"任务编号: {self.case_id}\n"
            f"任务类型: {self.category}\n\n"
            f"【数据上下文】\n{self.context}\n\n"
            f"【问题】\n{self.question}\n\n"
            "【回答要求】\n"
