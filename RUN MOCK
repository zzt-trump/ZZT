def extract_numbers(text: str) -> List[float]:
    numbers: List[float] = []
    for match in re.finditer(r"[-+]?\d+(?:\.\d+)?%?", text):
        token = match.group(0)
        try:
            if token.endswith("%"):
                numbers.append(float(token[:-1]))
            else:
                numbers.append(float(token))
        except ValueError:
            continue
    return numbers


def extract_json_object(text: str) -> Optional[Dict[str, Any]]:
    candidates = []
    stripped = text.strip()
    if stripped.startswith("{") and stripped.endswith("}"):
        candidates.append(stripped)
    match = re.search(r"\{.*\}", text, flags=re.DOTALL)
    if match:
        candidates.append(match.group(0))
    for candidate in candidates:
        try:
            value = json.loads(candidate)
            if isinstance(value, dict):
                return value
        except json.JSONDecodeError:
            continue
    return None


def normalize_text(value: Any) -> str:
    return str(value if value is not None else "").strip().lower().replace(" ", "")


def score_case(case: Case, output: str) -> Dict[str, Any]:
    scoring = case.scoring
    scoring_type = scoring.get("type")
    text_norm = normalize_text(output)

    if scoring_type == "contains_all":
        terms = [str(t) for t in scoring.get("terms", []) if str(t)]
        hits = [term for term in terms if normalize_text(term) in text_norm]
        score = len(hits) / len(terms) if terms else 0.0
        return {
            "score": score,
            "passed": score >= 0.999,
            "details": {"hits": hits, "missing": [t for t in terms if t not in hits]},
        }

    if scoring_type == "numeric_contains":
        terms = [str(t) for t in scoring.get("terms", []) if str(t)]
        term_hits = [term for term in terms if normalize_text(term) in text_norm]
        numbers = extract_numbers(output)
        expected_numbers = scoring.get("numbers", [])
        number_hits = []
        missing_numbers = []
        for item in expected_numbers:
            expected = float(item["value"])
            tolerance = float(item.get("tolerance", 0.01))
            hit = any(abs(value - expected) <= tolerance for value in numbers)
            if not hit and abs(expected) <= 1:
                hit = any(abs(value - expected * 100) <= max(tolerance * 100, 0.2) for value in numbers)
            if hit:
                number_hits.append(expected)
            else:
                missing_numbers.append(expected)
        term_score = len(term_hits) / len(terms) if terms else 1.0
        number_score = len(number_hits) / len(expected_numbers) if expected_numbers else 1.0
        score = 0.35 * term_score + 0.65 * number_score
        return {
            "score": score,
            "passed": score >= 0.85,
            "details": {
                "term_hits": term_hits,
                "missing_terms": [t for t in terms if t not in term_hits],
                "number_hits": number_hits,
                "missing_numbers": missing_numbers,
                "numbers_found": numbers,
            },
        }

    if scoring_type == "json_fields":
        expected_fields = scoring.get("fields", {})
        parsed = extract_json_object(output)
        if parsed is None:
            return {"score": 0.0, "passed": False, "details": {"error": "no valid JSON object"}}
        hits = []
        missing = []
        for key, expected in expected_fields.items():
            actual = parsed.get(key)
            if isinstance(expected, (int, float)):
                actual_num = num(actual, default=float("nan"))
                if math.isfinite(actual_num) and abs(actual_num - float(expected)) <= 0.2:
                    hits.append(key)
                else:
                    missing.append({"field": key, "expected": expected, "actual": actual})
            elif normalize_text(actual) == normalize_text(expected):
                hits.append(key)
            else:
                missing.append({"field": key, "expected": expected, "actual": actual})
        score = len(hits) / len(expected_fields) if expected_fields else 0.0
        return {"score": score, "passed": score >= 0.999, "details": {"hits": hits, "missing": missing, "parsed": parsed}}

    return {"score": 0.0, "passed": False, "details": {"error": f"unknown scoring type {scoring_type}"}}


