        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": prompt},
        ],
        "options": {
            "temperature": args.temperature,
            "num_predict": args.max_tokens,
        },
    }
    started = time.perf_counter()
    payload = http_json(f"{args.model_base_url.rstrip('/')}/api/chat", method="POST", body=body, timeout=args.timeout)
    elapsed = time.perf_counter() - started
    content = str(payload.get("message", {}).get("content", ""))
    return {
        "content": content,
        "latency_sec": elapsed,
        "raw_usage": {
            "prompt_eval_count": payload.get("prompt_eval_count"),
            "eval_count": payload.get("eval_count"),
            "total_duration": payload.get("total_duration"),
            "load_duration": payload.get("load_duration"),
            "prompt_eval_duration": payload.get("prompt_eval_duration"),
            "eval_duration": payload.get("eval_duration"),
        },
    }


def call_openai_compatible(args: argparse.Namespace, prompt: str) -> Dict[str, Any]:
    body = {
        "model": args.model,
        "messages": [
            {"role": "system", "content": "/nothink\n" + SYSTEM_PROMPT},
            {"role": "user", "content": prompt},
        ],
        "temperature": args.temperature,
        "max_tokens": args.max_tokens,
        "stream": False,
    }
    headers = {"Authorization": f"Bearer {args.api_key}"}
    started = time.perf_counter()
    payload = http_json(
        f"{args.openai_base_url.rstrip('/')}/chat/completions",
        method="POST",
        body=body,
        headers=headers,
        timeout=args.timeout,
    )
    elapsed = time.perf_counter() - started
    choices = payload.get("choices", [])
    content = ""
    if choices:
        content = str(choices[0].get("message", {}).get("content", ""))
    return {"content": content, "latency_sec": elapsed, "raw_usage": payload.get("usage", {})}


def call_model(args: argparse.Namespace, prompt: str) -> Dict[str, Any]:
    if args.model_api == "openai":
        return call_openai_compatible(args, prompt)
    return call_ollama_native(args, prompt)


def dataset_profile(tables: Dict[str, TableData]) -> List[Dict[str, Any]]:
    rows = []
    for table_id in sorted(tables):
        table = tables[table_id]
        rows.append(
            {
                "table_id": table.table_id,
                "name": table.name,
                "service": table.service,
                "rows": len(table.rows),
                "columns": len(table.columns),
                "file": table.file,
            }
        )
    return rows


def pctl(values: Sequence[float], percentile: float) -> float:
    if not values:
        return 0.0
    sorted_values = sorted(values)
    idx = (len(sorted_values) - 1) * percentile
    lo = math.floor(idx)
    hi = math.ceil(idx)
    if lo == hi:
        return sorted_values[int(idx)]
    return sorted_values[lo] + (sorted_values[hi] - sorted_values[lo]) * (idx - lo)


def shorten(text: str, limit: int = 120) -> str:
    text = " ".join(str(text).split())
    if len(text) <= limit:
        return text
    return text[: limit - 1] + "…"


def case_to_json(case: Case) -> Dict[str, Any]:
    return {
        "case_id": case.case_id,
        "category": case.category,
        "difficulty": case.difficulty,
        "source_tables": case.source_tables,
        "question": case.question,
        "context": case.context,
        "expected": case.expected,
        "scoring": case.scoring,
        "tags": case.tags,
    }


def write_jsonl(path: Path, records: Iterable[Dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8", newline="\n") as f:
        for record in records:
            f.write(json.dumps(record, ensure_ascii=False) + "\n")


def render_report(
    args: argparse.Namespace,
    tables: Dict[str, TableData],
    cases: Sequence[Case],
    results: Sequence[Dict[str, Any]],
    run_id: str,
    out_dir: Path,
    dry_run: bool,
) -> str:
    profile = dataset_profile(tables)
    total_rows = sum(item["rows"] for item in profile)
    total_columns = sum(item["columns"] for item in profile)
    lines: List[str] = []
    lines.append("# Qwen9B Mock 数据 Benchmark 报告")
    lines.append("")
    lines.append("## 1. 基本信息")
    lines.append("")
    lines.append(f"- 生成时间: {utc_now_text()}")
    lines.append(f"- Run ID: `{run_id}`")
    lines.append(f"- 模型: `{args.model}`")
    lines.append(f"- 模型接口模式: `{args.model_api}`")
    lines.append(f"- 模型地址: `{args.openai_base_url if args.model_api == 'openai' else args.model_base_url}`")
    lines.append(f"- 数据来源: `{args.source}`")
    lines.append(f"- 测试题数: {len(cases)}")
    lines.append(f"- 数据规模: {len(profile)} 张表 / {total_rows} 行 / {total_columns} 个字段")
    if dry_run:
        lines.append("- 执行状态: dry-run，仅生成题集与报告结构，未调用模型。")
    else:
        lines.append("- 执行状态: 已调用模型并完成自动评分。")
    lines.append("")

    lines.append("## 2. 数据集概览")
    lines.append("")
    lines.append("| 表ID | 表名 | 服务 | 行数 | 字段数 | 文件 |")
    lines.append("| --- | --- | --- | ---: | ---: | --- |")
    for item in profile:
        lines.append(
            f"| {item['table_id']} | {item['name']} | {item['service']} | {item['rows']} | {item['columns']} | {item['file']} |"
        )
    lines.append("")

    lines.append("## 3. Benchmark 设计")
    lines.append("")
    lines.append("本次 benchmark 覆盖 API 路由、单表查询、计算、日期推理、聚合、跨表关联、BOM 展开、异常识别和结构化输出。标准答案由 CSV/mock API 数据自动计算生成，避免人工答案与数据漂移。")
    lines.append("")
    lines.append("| 类别 | 题数 | 目的 |")
    lines.append("| --- | ---: | --- |")
    category_counts: Dict[str, int] = {}
    for case in cases:
        category_counts[case.category] = category_counts.get(case.category, 0) + 1
    category_desc = {
        "api_planning": "验证模型能否选择正确服务、表、endpoint 与 token",
        "single_table_lookup": "验证从给定行中抽取关键字段",
        "calculation": "验证数量、金额、比例和偏差计算",
        "date_reasoning": "验证日期比较与延期计算",
        "aggregation": "验证小表汇总、排序和分组判断",
        "cross_table_join": "验证 ERP/MES 跨表关联追溯",
        "bom_explosion": "验证 BOM 单位用量展开",
        "anomaly_detection": "验证计量异常和标准范围判断",
        "structured_output": "验证 JSON 输出约束遵循",
    }
    for category, count in sorted(category_counts.items()):
        lines.append(f"| {category} | {count} | {category_desc.get(category, '')} |")
    lines.append("")

    if results:
        passed = sum(1 for r in results if r["passed"])
        scores = [float(r["score"]) for r in results]
        latencies = [float(r["latency_sec"]) for r in results]
        lines.append("## 4. 总体结果")
        lines.append("")
        lines.append(f"- 通过率: {passed}/{len(results)} = {passed / len(results):.1%}")
        lines.append(f"- 平均分: {statistics.mean(scores):.3f}")
        lines.append(f"- 平均延迟: {statistics.mean(latencies):.2f}s")
        lines.append(f"- P50 延迟: {pctl(latencies, 0.50):.2f}s")
        lines.append(f"- P95 延迟: {pctl(latencies, 0.95):.2f}s")
        lines.append("")

        lines.append("## 5. 分类结果")
        lines.append("")
        lines.append("| 类别 | 题数 | 通过率 | 平均分 | 平均延迟 |")
        lines.append("| --- | ---: | ---: | ---: | ---: |")
        by_category: Dict[str, List[Dict[str, Any]]] = {}
        for result in results:
            by_category.setdefault(result["category"], []).append(result)
        for category, rows in sorted(by_category.items()):
            cat_passed = sum(1 for r in rows if r["passed"])
            cat_scores = [float(r["score"]) for r in rows]
            cat_lat = [float(r["latency_sec"]) for r in rows]
            lines.append(
                f"| {category} | {len(rows)} | {cat_passed / len(rows):.1%} | {statistics.mean(cat_scores):.3f} | {statistics.mean(cat_lat):.2f}s |"
            )
        lines.append("")

        lines.append("## 6. 明细结果")
        lines.append("")
        lines.append("| Case | 类别 | 难度 | 分数 | 通过 | 延迟 | 标准答案 | 模型 FINAL/输出摘要 |")
        lines.append("| --- | --- | --- | ---: | --- | ---: | --- | --- |")
        for result in results:
            ok = "PASS" if result["passed"] else "FAIL"
            lines.append(
                f"| {result['case_id']} | {result['category']} | {result['difficulty']} | "
                f"{float(result['score']):.3f} | {ok} | {float(result['latency_sec']):.2f}s | "
                f"{shorten(result['expected'], 80)} | {shorten(result['final_answer'] or result['output'], 100)} |"
            )
        lines.append("")

        failed = [r for r in results if not r["passed"]]
        lines.append("## 7. 失败分析")
        lines.append("")
        if failed:
            lines.append(f"共有 {len(failed)} 个 case 未通过，建议优先查看下列题目对应的原始输出 JSONL：")
            lines.append("")
            for result in failed[:10]:
                lines.append(
                    f"- `{result['case_id']}` / {result['category']} / score={float(result['score']):.3f}: "
                    f"expected `{shorten(result['expected'], 90)}`"
                )
        else:
            lines.append("所有 case 均通过。后续可以扩大题量、提高上下文长度或加入噪声字段来继续压测。")
        lines.append("")

        lines.append("## 8. 改进建议")
        lines.append("")
        if failed:
            low_categories = sorted(
                by_category.items(),
                key=lambda kv: statistics.mean([float(r["score"]) for r in kv[1]]),
            )[:3]
            lines.append("- 优先优化低分类型的 prompt，尤其是要求 `FINAL:` 行、单位和 JSON 字段名的约束。")
            lines.append("- 对跨表关联和 BOM 展开题，可以在系统提示中固定“先识别主键/关联键，再计算”的操作顺序。")
            lines.append("- 若延迟过高，可先降低 `--max-tokens`，并保持 `think:false` 或 OpenAI 兼容接口的 `/nothink`。")
            lines.append(
                "- 当前相对薄弱类别: "
                + "、".join(f"{cat}({statistics.mean([float(r['score']) for r in rows]):.2f})" for cat, rows in low_categories)
            )
        else:
            lines.append("- 当前题集表现良好，可以增加更多跨源 join、长上下文检索、异常边界值和多步骤计算题。")
            lines.append("- 建议固定温度为 0 或 0.1 做可复现评测，再用 0.7 做鲁棒性对比。")
        lines.append("")
    else:
        lines.append("## 4. 待执行项")
        lines.append("")
        lines.append("本报告是 dry-run 版本，已验证数据加载和题集生成。请在 Mac 上启动 Ollama 后去掉 `--dry-run` 运行，即可得到第 4-8 节的真实模型结果。")
        lines.append("")
        lines.append("推荐命令：")
        lines.append("")
        lines.append("```bash")
        lines.append("python3 benchmark/run_benchmark.py --source csv --csv-dir /path/to/mock_csv --model qwen3.5:9b")
        lines.append("```")
        lines.append("")

    lines.append("## 9. 输出文件")
    lines.append("")
    out_text = out_dir.as_posix()
    lines.append(f"- 题集: `{out_text}/cases.jsonl`")
    lines.append(f"- 原始结果: `{out_text}/results.jsonl`")
    lines.append(f"- 报告: `{out_text}/benchmark_report.md`")
    lines.append("")
    return "\n".join(lines)


def final_answer(output: str) -> str:
    matches = re.findall(r"FINAL\s*[:：]\s*(.+)", output, flags=re.IGNORECASE)
    if matches:
        return matches[-1].strip()
    return ""


def run(args: argparse.Namespace) -> int:
    if args.source == "csv":
        tables = load_from_csv(args.csv_dir)
    elif args.source == "api":
        tables = load_from_api(args)
    else:
        try:
            tables = load_from_csv(args.csv_dir)
            args.source = "csv"
        except Exception:
            tables = load_from_api(args)
            args.source = "api"

    cases = build_cases(tables, max_cases=args.max_cases)
    if not cases:
        raise RuntimeError("No benchmark cases could be generated from the available tables")

    run_id = args.run_id or dt.datetime.now().strftime("%Y%m%d_%H%M%S")
    out_dir = Path(args.out_dir) / run_id
    out_dir.mkdir(parents=True, exist_ok=True)

    write_jsonl(out_dir / "cases.jsonl", [case_to_json(case) for case in cases])

    results: List[Dict[str, Any]] = []
    if not args.dry_run:
        for index, case in enumerate(cases, start=1):
            print(f"[{index}/{len(cases)}] {case.case_id} {case.category}", flush=True)
            model_result = call_model(args, case.prompt())
            score = score_case(case, model_result["content"])
            record = {
                "run_id": run_id,
                "case_id": case.case_id,
                "category": case.category,
                "difficulty": case.difficulty,
                "source_tables": case.source_tables,
                "question": case.question,
                "expected": case.expected,
                "output": model_result["content"],
                "final_answer": final_answer(model_result["content"]),
                "score": score["score"],
                "passed": score["passed"],
                "score_details": score["details"],
                "latency_sec": model_result["latency_sec"],
                "raw_usage": model_result["raw_usage"],
            }
            results.append(record)
            write_jsonl(out_dir / "results.jsonl", results)
            if args.sleep_sec > 0:
                time.sleep(args.sleep_sec)
    else:
        write_jsonl(out_dir / "results.jsonl", [])

    report = render_report(args, tables, cases, results, run_id, out_dir, dry_run=args.dry_run)
    report_path = out_dir / "benchmark_report.md"
    report_path.write_text(report, encoding="utf-8", newline="\n")

    print(f"\nCases: {out_dir / 'cases.jsonl'}")
    print(f"Results: {out_dir / 'results.jsonl'}")
    print(f"Report: {report_path}")
    if results:
        passed = sum(1 for r in results if r["passed"])
        print(f"Pass rate: {passed}/{len(results)} = {passed / len(results):.1%}")
    return 0


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run a local Qwen/Ollama benchmark on ERP/MES mock data.")
    parser.add_argument("--source", choices=["auto", "csv", "api"], default="csv", help="Where to load mock data from.")
    parser.add_argument("--csv-dir", default="./mock_csv", help="Directory containing T*.csv files.")
    parser.add_argument("--erp-api", default=DEFAULT_ERP_API, help="ERP mock API base URL.")
    parser.add_argument("--mes-api", default=DEFAULT_MES_API, help="MES mock API base URL.")
    parser.add_argument("--erp-token", default=DEFAULT_ERP_TOKEN, help="ERP mock API token.")
    parser.add_argument("--mes-token", default=DEFAULT_MES_TOKEN, help="MES mock API token.")
    parser.add_argument("--model-api", choices=["ollama", "openai"], default="ollama", help="Model API style.")
    parser.add_argument("--model-base-url", default="http://localhost:11434", help="Ollama native API base URL.")
    parser.add_argument("--openai-base-url", default="http://localhost:11434/v1", help="OpenAI-compatible base URL.")
    parser.add_argument("--api-key", default="ollama", help="API key for OpenAI-compatible mode.")
    parser.add_argument("--model", default="qwen3.5:9b", help="Model name.")
    parser.add_argument("--temperature", type=float, default=0.1, help="Low temperature is recommended for reproducible benchmark runs.")
    parser.add_argument("--max-tokens", type=int, default=512, help="Maximum output tokens.")
    parser.add_argument("--timeout", type=float, default=120, help="Per-case request timeout in seconds.")
    parser.add_argument("--max-cases", type=int, default=0, help="Optional cap on generated cases; 0 means all.")
    parser.add_argument("--sleep-sec", type=float, default=0.0, help="Sleep between model calls.")
    parser.add_argument("--out-dir", default="benchmark/outputs", help="Output directory.")
    parser.add_argument("--run-id", default="", help="Optional stable run id.")
    parser.add_argument("--dry-run", action="store_true", help="Only load data, generate cases, and write a report skeleton.")
    return parser.parse_args(argv)


def main() -> int:
    try:
        return run(parse_args())
    except KeyboardInterrupt:
        print("Interrupted.", file=sys.stderr)
        return 130
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
