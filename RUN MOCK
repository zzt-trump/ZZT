            total_amount = sum(num(r.get("采购数量")) * num(r.get("含税单价(元)")) for r in rows)
            add_case(
                cases,
                Case(
                    case_id="CAL-002",
                    category="calculation",
                    difficulty="medium",
                    source_tables=["t05"],
                    context=markdown_table(rows, ["采购订单行ID", "供应商编码", "供应商名称", "物料名称", "采购数量", "含税单价(元)"]),
