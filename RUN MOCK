    t05 = tables.get("t05")
    if t05 and t05.rows:
        row = t05.rows[0]
        add_case(
            cases,
            Case(
                case_id="LKP-001",
                category="single_table_lookup",
                difficulty="easy",
                source_tables=["t05"],
                context=markdown_table([row], ["采购订单行ID", "采购订单号", "供应商名称", "物料名称", "采购数量", "已到货量", "含税单价(元)", "采购状态"]),
